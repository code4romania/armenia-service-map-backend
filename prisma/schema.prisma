generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  ORG_ADMIN
  ORG_MEMBER
}

enum UserStatus {
  ACTIVE
  PENDING
  SUSPENDED
}

enum OrganisationStatus {
  ACTIVE
  PENDING
  REJECTED
  SUSPENDED
}

enum EntityStatus {
  ACTIVE
  INACTIVE
}

enum ServiceStatus {
  DRAFT
  PUBLISHED
}

enum NeedStatus {
  NEW
  IN_PROGRESS
  SOLVED
  CLOSED
}

enum NeedReportEventType {
  COMMENT
  STATUS_CHANGE
  TAG_ADDED
  TAG_REMOVED
  ASSIGNED
  TITLE_EDITED
}

enum NotificationType {
  NEED_SUBMITTED
  NEED_ASSIGNED
  NEED_STATUS_CHANGED
  NEED_COMMENT_ADDED
  SERVICE_PUBLISHED
  ORG_ACTIVATED
  ORG_REVIEWED
  ORG_PENDING_REVIEW
}

model Region {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  svgPathId String   @map("svg_path_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organisationRegions OrganisationRegion[]
  services      Service[]
  needReports   NeedReport[]
  searchLogs    SearchLog[]
  subscriptions Subscription[]

  @@map("regions")
}

model Organisation {
  id                 String             @id @default(uuid())
  name               String
  legalName          String?            @map("legal_name")
  description        String?
  website            String?
  country            String?
  streetAddress      String?            @map("street_address")
  location           String?
  organisationType   String?            @map("organisation_type")
  uniqueIdentifier   String?            @map("unique_identifier")
  category           String?
  activityDomain     String?            @map("activity_domain")
  legalRepName       String?            @map("legal_rep_name")
  legalRepEmail      String?            @map("legal_rep_email")
  legalRepPhone      String?            @map("legal_rep_phone")
  contactPersonName  String?            @map("contact_person_name")
  contactPersonEmail String?            @map("contact_person_email")
  contactPersonPhone String?            @map("contact_person_phone")
  legalDocumentUrl   String?            @map("legal_document_url")
  logoUrl            String?            @map("logo_url")
  observations       String?
  tags               String[]
  status             OrganisationStatus @default(PENDING)
  submissionSource   String?            @map("submission_source")
  reviewedAt         DateTime?          @map("reviewed_at")
  reviewedByUserId   String?            @map("reviewed_by_user_id")
  rejectionReason    String?            @map("rejection_reason")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  deletedAt          DateTime?          @map("deleted_at")

  regions             OrganisationRegion[]
  users               User[]
  services            Service[]
  assignedNeedReports NeedReport[]

  @@map("organisations")
}

model OrganisationRegion {
  organisationId String @map("organisation_id")
  regionId       String @map("region_id")

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  region       Region       @relation(fields: [regionId], references: [id], onDelete: Cascade)

  @@id([organisationId, regionId])
  @@index([regionId])
  @@map("organisation_regions")
}

model User {
  id             String      @id @default(uuid())
  email          String      @unique
  passwordHash   String      @map("password_hash")
  firstName      String      @map("first_name")
  lastName       String      @map("last_name")
  phone          String?
  status         UserStatus  @default(ACTIVE)
  lastAccessAt   DateTime?   @map("last_access_at")
  role           Role        @default(ORG_MEMBER)
  organisationId String?     @map("organisation_id")
  avatarUrl      String?     @map("avatar_url")
  refreshToken   String?     @map("refresh_token")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")
  deletedAt      DateTime?   @map("deleted_at")

  organisation     Organisation?    @relation(fields: [organisationId], references: [id])
  needReportEvents NeedReportEvent[]
  notifications    Notification[]

  @@map("users")
}

model Topic {
  id        String       @id @default(uuid())
  name      String
  slug      String       @unique
  icon      String?
  parentId  String?      @map("parent_id")
  status    EntityStatus @default(ACTIVE)
  sortOrder Int          @default(0) @map("sort_order")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  services      ServiceTopic[]
  parent        Topic?        @relation("TopicHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children      Topic[]       @relation("TopicHierarchy")
  subscriptions Subscription[]

  @@index([parentId])
  @@map("topics")
}

model Service {
  id                String        @id @default(uuid())
  title             String?
  titleHy           String?       @map("title_hy")
  shortDescription  String?       @map("short_description")
  shortDescriptionHy String?      @map("short_description_hy")
  description       String?
  descriptionHy     String?       @map("description_hy")
  howToAccess       String?       @map("how_to_access")
  howToAccessHy     String?       @map("how_to_access_hy")
  organisationId           String?       @map("organisation_id")
  externalOrganisationName String?       @map("external_organisation_name")
  regionId          String?       @map("region_id")
  status            ServiceStatus @default(DRAFT)
  isAvailable       Boolean       @default(true) @map("is_available")
  availabilityStart DateTime?     @map("availability_start")
  availabilityEnd   DateTime?     @map("availability_end")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  deletedAt         DateTime?     @map("deleted_at")

  organisation  Organisation?      @relation(fields: [organisationId], references: [id])
  region        Region?            @relation(fields: [regionId], references: [id])
  topics        ServiceTopic[]
  targetGroups  ServiceTargetGroup[]

  @@map("services")
}

model ServiceTopic {
  serviceId String @map("service_id")
  topicId   String @map("topic_id")

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  topic   Topic   @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([serviceId, topicId])
  @@map("service_topics")
}

model TargetGroup {
  id        String       @id @default(uuid())
  name      String
  status    EntityStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  services ServiceTargetGroup[]

  @@map("target_groups")
}

model ServiceTargetGroup {
  serviceId     String @map("service_id")
  targetGroupId String @map("target_group_id")

  service     Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  targetGroup TargetGroup @relation(fields: [targetGroupId], references: [id], onDelete: Cascade)

  @@id([serviceId, targetGroupId])
  @@map("service_target_groups")
}

model NeedTag {
  id        String       @id @default(uuid())
  name      String
  slug      String       @unique
  status    EntityStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  needReports NeedReportTag[]

  @@map("need_tags")
}

model NeedReport {
  id                     String          @id @default(uuid())
  title                  String          @default("")
  description            String
  fullName               String          @map("full_name")
  contactMethod          String          @map("contact_method")
  contactValue           String          @map("contact_value")
  regionId               String?         @map("region_id")
  status                 NeedStatus      @default(NEW)
  assignedOrganisationId String?         @map("assigned_organisation_id")
  createdAt              DateTime        @default(now()) @map("created_at")
  updatedAt              DateTime        @updatedAt @map("updated_at")

  region               Region?            @relation(fields: [regionId], references: [id])
  assignedOrganisation Organisation?      @relation(fields: [assignedOrganisationId], references: [id])
  tags                 NeedReportTag[]
  events               NeedReportEvent[]

  @@map("need_reports")
}

model NeedReportTag {
  needReportId String @map("need_report_id")
  needTagId    String @map("need_tag_id")

  needReport NeedReport @relation(fields: [needReportId], references: [id], onDelete: Cascade)
  needTag    NeedTag    @relation(fields: [needTagId], references: [id], onDelete: Cascade)

  @@id([needReportId, needTagId])
  @@map("need_report_tags")
}

model NeedReportEvent {
  id           String              @id @default(uuid())
  needReportId String              @map("need_report_id")
  userId       String              @map("user_id")
  eventType    NeedReportEventType @map("event_type")
  content      String?
  metadata     Json?
  createdAt    DateTime            @default(now()) @map("created_at")

  needReport NeedReport @relation(fields: [needReportId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([needReportId, createdAt])
  @@map("need_report_events")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  type      NotificationType
  title     String
  message   String
  readAt    DateTime?        @map("read_at")
  metadata  Json?
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

model SearchLog {
  id           String   @id @default(uuid())
  query        String
  regionId     String?  @map("region_id")
  topicIds     String[] @map("topic_ids")
  resultsCount Int      @map("results_count")
  createdAt    DateTime @default(now()) @map("created_at")

  region Region? @relation(fields: [regionId], references: [id])

  @@map("search_logs")
}

model Subscriber {
  id               String         @id @default(uuid())
  email            String         @unique
  locale           String         @default("en")
  unsubscribeToken String         @unique @map("unsubscribe_token")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  subscriptions    Subscription[]

  @@map("subscribers")
}

model Subscription {
  id           String     @id @default(uuid())
  subscriberId String     @map("subscriber_id")
  regionId     String?    @map("region_id")
  topicId      String?    @map("topic_id")
  createdAt    DateTime   @default(now()) @map("created_at")

  subscriber   Subscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  region       Region?    @relation(fields: [regionId], references: [id])
  topic        Topic?     @relation(fields: [topicId], references: [id])

  @@index([regionId])
  @@index([topicId])
  @@map("subscriptions")
}
