# Database
DATABASE_URL=postgresql://armenia_user:armenia_pass@localhost:5432/armenia_service_map

# JWT
JWT_ACCESS_SECRET=your-access-secret-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=armenia-service-map
S3_REGION=us-east-1
UPLOAD_MAX_IMAGE_BYTES=5242880
UPLOAD_MAX_DOCUMENT_BYTES=10485760

# Mail
# MAIL_TRANSPORT=ses  (default) -> Amazon SES on staging/production. Reuses
#                        S3_ACCESS_KEY / S3_SECRET_KEY; region is SES_REGION,
#                        falling back to S3_REGION. MAIL_FROM must be a verified
#                        SES identity (address or domain).
# MAIL_TRANSPORT=smtp -> local mailcatcher (MAIL_HOST/MAIL_PORT). Set this locally.
MAIL_TRANSPORT=smtp
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=noreply@refugeesupport.am
SES_REGION=

# App
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3001
AUTO_DB_INIT=true
