# Database
DATABASE_URL=postgresql://armenia_user:armenia_pass@localhost:5432/armenia_service_map

# JWT
JWT_ACCESS_SECRET=your-access-secret-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=armenia-service-map
S3_REGION=us-east-1
UPLOAD_MAX_IMAGE_BYTES=5242880
UPLOAD_MAX_DOCUMENT_BYTES=10485760

# Mail (mailcatcher)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=noreply@refugeesupport.am

# Postmark (production email delivery).
# When POSTMARK_SERVER_TOKEN is set, email is sent via Postmark instead of SMTP.
# Use "broadcast" for bulk/notification streams or "outbound" for transactional.
POSTMARK_SERVER_TOKEN=
POSTMARK_MESSAGE_STREAM=outbound

# App
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3001
AUTO_DB_INIT=true
